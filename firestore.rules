rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId']) &&
             data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'isGuest', 'activePlanId', 'preferences', 'weightUnit', 'updatedAt']) &&
             data.userId == userId &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 500)) &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 300)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 5000)) &&
             (!('isGuest' in data) || data.isGuest == null || data.isGuest is bool) &&
             (!('activePlanId' in data) || data.activePlanId == null || (data.activePlanId is string && data.activePlanId.size() <= 128)) &&
             (!('preferences' in data) || data.preferences == null || (data.preferences is string && data.preferences.size() <= 50000)) &&
             (!('weightUnit' in data) || data.weightUnit == null || (data.weightUnit in ['kg', 'lbs'])) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 128));
    }

    // User Workout Plan Validation
    function isValidPlan(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name']) &&
             data.keys().hasOnly(['id', 'userId', 'name', 'description', 'daysCount', 'isCustom', 'days', 'updatedAt']) &&
             data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 2000)) &&
             (!('daysCount' in data) || data.daysCount == null || data.daysCount is number) &&
             (!('isCustom' in data) || data.isCustom == null || data.isCustom is bool) &&
             (!('days' in data) || data.days == null || (data.days is string && data.days.size() <= 500000)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 128));
    }

    // User Session Log Validation
    function isValidSessionLog(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'date']) &&
             data.keys().hasOnly(['id', 'userId', 'planId', 'dayKey', 'dayTitle', 'date', 'timestamp', 'completed', 'exercises', 'durationSeconds', 'updatedAt']) &&
             data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('planId' in data) || data.planId == null || (data.planId is string && data.planId.size() <= 128)) &&
             (!('dayKey' in data) || data.dayKey == null || (data.dayKey is string && data.dayKey.size() <= 64)) &&
             (!('dayTitle' in data) || data.dayTitle == null || (data.dayTitle is string && data.dayTitle.size() <= 200)) &&
             (!('timestamp' in data) || data.timestamp == null || data.timestamp is number) &&
             (!('completed' in data) || data.completed == null || data.completed is bool) &&
             (!('durationSeconds' in data) || data.durationSeconds == null || data.durationSeconds is number) &&
             (!('exercises' in data) || data.exercises == null || (data.exercises is string && data.exercises.size() <= 500000)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 128));
    }

    // User Root Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
                       (!('userId' in existing()) || incoming().userId == existing().userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Custom Workout Plans Subcollection
      match /plans/{planId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(planId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(planId) && isValidPlan(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(planId) && isValidPlan(incoming(), userId) &&
                         (!('userId' in existing()) || incoming().userId == existing().userId) &&
                         (!('id' in existing()) || incoming().id == existing().id);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(planId);
      }

      // User Session Logs Subcollection
      match /logs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(logId) && isValidSessionLog(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(logId) && isValidSessionLog(incoming(), userId) &&
                         (!('userId' in existing()) || incoming().userId == existing().userId) &&
                         (!('id' in existing()) || incoming().id == existing().id);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(logId);
      }
    }
  }
}
